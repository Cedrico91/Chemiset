---
import { PLACEHOLDER } from '../lib/url';
import Base from '../layouts/Base.astro';
import ContactBlock from '../components/ContactBlock.astro';
import MapPlaceholder from '../components/MapPlaceholder.astro';
import Services from '../components/Services.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site } from '../config/site';
import { visuals } from '../data/catalogue';
import { designers, products, shopPaths } from '../lib/catalogue';
---

<Base title="La boutique" description={site.description} current="a-propos">
  <section class="section--tight section">
    <div class="container intro">
      <div class="intro__text">
        <p class="eyebrow eyebrow--accent">La boutique</p>
        <h1 class="title-xl">Du prêt-à-porter de créateurs africains, à Cotonou</h1>
        <p class="lede">{site.description}</p>
        <div class="intro__body">
          <p>
            La chemise d’abord, celle qui a donné son nom à la maison. Puis tout ce qui l’accompagne : robes, ensembles,
            tuniques, boubous, bijoux et foulards, choisis chez plusieurs créateurs d’Afrique de l’Ouest. Chaque pièce est
            présentée avec le nom de celui ou celle qui l’a dessinée.
          </p>
          <p>
            La commande reste simple : un panier, un message WhatsApp, un échange sur la taille ou la retouche, puis la
            livraison ou le retrait en boutique.
          </p>
        </div>
        <div class="intro__facts">
          <div><strong>{designers.length}</strong><span class="eyebrow">créateurs</span></div>
          <div><strong>{products.length}</strong><span class="eyebrow">pièces en boutique</span></div>
        </div>
      </div>
      <figure class="intro__media">
        <div class="img-frame" style="aspect-ratio: 4 / 3;">
          <img src={visuals.atelier.src} alt={visuals.atelier.alt} width={visuals.atelier.width} height={visuals.atelier.height} loading="eager" decoding="async" onerror={`this.onerror=null;this.src='${PLACEHOLDER}'`} />
        </div>
        {site.demo && <figcaption class="eyebrow">Visuel d’illustration · {visuals.atelier.credit}</figcaption>}
      </figure>
    </div>
  </section>

  <section class="section section--paper-2" id="commander">
    <div class="container steps">
      <div class="steps__head">
        <p class="eyebrow eyebrow--accent">Comment commander</p>
        <h2 class="title-xl">Trois étapes, zéro formulaire</h2>
      </div>
      <ol class="steps__list">
        <li><span class="steps__n">01</span><h3>Composez votre panier</h3><p class="muted">Ajoutez une ou plusieurs pièces, choisissez vos tailles. Ou commandez une pièce directement depuis sa fiche.</p></li>
        <li><span class="steps__n">02</span><h3>Envoyez-le sur WhatsApp</h3><p class="muted">Le récapitulatif part en un message déjà rédigé. Taille, coloris, retouche, délai, règlement : tout se règle dans la conversation.</p></li>
        <li><span class="steps__n">03</span><h3>Recevez votre pièce</h3><p class="muted">Livraison ou retrait en boutique, selon ce qui vous arrange.</p></li>
      </ol>
      <div class="steps__actions">
        <WhatsAppButton size="lg" />
        <a class="link-underline" href={shopPaths.faq}>Questions fréquentes</a>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <p class="eyebrow services-title">Nos services</p>
      <Services />
    </div>
  </section>

  <section class="section">
    <div class="container contact">
      <div>
        <p class="eyebrow">Contact</p>
        <h2 class="title-xl contact__title">Nous écrire, nous trouver</h2>
        <ContactBlock />
      </div>
      <MapPlaceholder />
    </div>
  </section>

  {site.demo && (
    <section class="section section--paper-2" id="apercu">
      <div class="container demo">
        <p class="eyebrow eyebrow--accent">Version de travail</p>
        <h2 class="title-lg">Ce site est en cours de mise en place pour {site.name}</h2>
        <p class="muted measure">
          Les pièces, descriptions et prix affichés sont provisoires, et les photos sont des visuels d’illustration
          (Unsplash, Pexels). Ils seront remplacés par le catalogue de la boutique : ses photos, ses créateurs, ses prix,
          son numéro WhatsApp, son adresse et ses horaires.
        </p>
        <ul class="demo__list muted">
          <li><strong>Panier et favoris</strong> fonctionnent déjà, sans compte client : ils sont conservés dans le navigateur.</li>
          <li><strong>La commande</strong> part sur WhatsApp avec le récapitulatif du panier. Aucun paiement en ligne ; il pourra être ajouté plus tard (Mobile Money, carte).</li>
          <li><strong>Recherche, offres spéciales, guide des tailles, FAQ et newsletter</strong> sont inclus.</li>
        </ul>
      </div>
    </section>
  )}
</Base>

<style>
  .intro { display: grid; gap: var(--s-10); }
  .intro__text { display: grid; gap: var(--s-4); align-content: start; }
  .intro__body { display: grid; gap: var(--s-4); color: var(--ink-70); max-width: 56ch; margin-top: var(--s-2); }
  .intro__facts { display: flex; gap: var(--s-8); margin-top: var(--s-4); }
  .intro__facts div { display: grid; gap: var(--s-1); }
  .intro__facts strong { font-size: 2.25rem; font-weight: 600; line-height: 1; letter-spacing: -0.03em; }
  .intro__media { margin: 0; display: grid; gap: var(--s-2); }
  .steps { display: grid; gap: var(--s-10); justify-items: start; }
  .steps__head { display: grid; gap: var(--s-2); }
  .steps__list { display: grid; gap: var(--s-8); counter-reset: step; }
  .steps__list li { display: grid; gap: var(--s-2); padding-top: var(--s-4); border-top: 1px solid var(--line); }
  .steps__list h3 { font-size: var(--fs-lg); }
  .steps__n { font-family: var(--font-script); font-size: 1.4rem; color: var(--accent-ink); }
  .steps__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-6); font-size: var(--fs-sm); }
  .services-title { margin-bottom: var(--s-5); }
  .contact { display: grid; gap: var(--s-10); }
  .contact__title { margin: var(--s-2) 0 var(--s-8); }
  .demo { display: grid; gap: var(--s-3); }
  .demo__list { display: grid; gap: var(--s-2); max-width: 62ch; font-size: var(--fs-sm); margin-top: var(--s-2); }
  .demo__list strong { font-weight: 600; color: var(--ink); }
  @media (min-width: 960px) {
    .intro { grid-template-columns: 1.1fr 0.9fr; gap: var(--s-16); align-items: center; }
    .steps__list { grid-template-columns: repeat(3, 1fr); }
    .contact { grid-template-columns: 1fr 1fr; gap: var(--s-16); align-items: start; }
  }
</style>
