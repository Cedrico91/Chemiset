---
import { withBase, PLACEHOLDER } from '../lib/url';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CategoryTile from '../components/CategoryTile.astro';
import Services from '../components/Services.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProductGrid from '../components/ProductGrid.astro';
import CollectionCard from '../components/CollectionCard.astro';
import DesignerIndex from '../components/DesignerIndex.astro';
import MapPlaceholder from '../components/MapPlaceholder.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Button from '../components/Button.astro';
import { site } from '../config/site';
import { visuals } from '../data/catalogue';
import { orLabel } from '../lib/format';
import {
  designers, featuredCollections, getCollection, getProduct, newProducts, productsByCollection, promoProducts, shopPaths,
} from '../lib/catalogue';

const fresh = newProducts(8);
const shirts = getCollection('la-chemise');
const shirtPieces = shirts ? productsByCollection(shirts.slug).slice(0, 4) : [];
const collections = featuredCollections().filter((c) => c.slug !== 'la-chemise').slice(0, 3);
const offers = promoProducts().slice(0, 4);

/** Entrées par rayon. Les photos viennent du catalogue (à remplacer par les visuels de la boutique). */
const tileImage = (slug: string) => getProduct(slug)?.images[0] ?? visuals.duo;
const tiles = [
  { label: 'Chemises', note: 'La pièce signature', href: shopPaths.shirts, image: tileImage('chemise-cotonou') },
  { label: 'Femme', note: 'Robes, ensembles, tuniques', href: withBase('/catalogue/femme/'), image: tileImage('robe-ganvie') },
  { label: 'Homme', note: 'Chemises, tuniques, boubous', href: withBase('/catalogue/homme/'), image: tileImage('tunique-natitingou') },
  { label: 'Accessoires', note: 'Bijoux, foulards, sacs', href: withBase('/catalogue/accessoires/'), image: tileImage('collier-perles') },
];
---

<Base title={site.name} current="accueil">
  <Hero
    eyebrow={`${site.tagline} · ${site.city}`}
    title={site.positioning}
    text="Chemises, robes, ensembles et accessoires signés par des créateurs africains. Choisissez, ajoutez au panier, commandez sur WhatsApp."
    desktop={visuals.heroDesktop}
    mobile={visuals.heroMobile}
    primary={{ label: 'Voir les nouveautés', href: shopPaths.newArrivals }}
    secondary={{ label: 'Les chemises', href: shopPaths.shirts }}
  />

  <section class="section section--tight">
    <div class="container">
      <div class="tiles">
        {tiles.map((t, i) => <CategoryTile {...t} eager={i < 2} />)}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <SectionHeading eyebrow="Nouveautés" title="Les dernières pièces arrivées en boutique" link={{ label: 'Toutes les nouveautés', href: shopPaths.newArrivals }} />
      <ProductGrid products={fresh} eagerCount={4} />
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <Services />
    </div>
  </section>

  {shirts && (
    <section class="section section--ink signature">
      <div class="container">
        <div class="signature__head">
          <div>
            <p class="eyebrow signature__eyebrow">La pièce qui donne son nom à la boutique</p>
            <h2 class="signature__title script">La Chemise</h2>
            <p class="signature__text">{shirts.description}</p>
            <Button href={shopPaths.shirts} variant="accent">Toutes les chemises</Button>
          </div>
        </div>
        <div class="signature__grid">
          <ProductGrid products={shirtPieces} />
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Collections" title="Entrer par une envie plutôt que par un rayon" link={{ label: 'Toutes les collections', href: withBase('/collections/') }} />
      <div class="collections">
        {collections.map((c) => <CollectionCard collection={c} />)}
      </div>
    </div>
  </section>

  {offers.length > 0 && (
    <section class="section section--paper-2">
      <div class="container">
        <SectionHeading eyebrow="Offres spéciales" title="Quelques pièces à prix doux, le temps des tailles disponibles" link={{ label: 'Toutes les offres', href: shopPaths.offers }} />
        <ProductGrid products={offers} />
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Nos créateurs" title="Chaque pièce porte le nom de celui ou celle qui l’a dessinée" link={{ label: 'Tous les créateurs', href: withBase('/createurs/') }} />
      <DesignerIndex designers={designers} />
    </div>
  </section>

  <section class="section section--paper-2" id="boutique">
    <div class="container visit">
      <div class="visit__text">
        <p class="eyebrow eyebrow--accent">La boutique</p>
        <h2 class="title-xl">Venez essayer, ou commandez depuis chez vous.</h2>
        <p class="lede">Nos pièces se découvrent en boutique à {site.city}, et sur WhatsApp pour tout le reste : conseil, commande, livraison.</p>
        <dl class="visit__list">
          <div><dt class="eyebrow">Adresse</dt><dd>{orLabel(site.address, 'À confirmer')}, {site.city}</dd></div>
          <div><dt class="eyebrow">Horaires</dt><dd>{orLabel(site.hours, 'À confirmer')}</dd></div>
          <div><dt class="eyebrow">WhatsApp</dt><dd>{site.whatsapp ? `+${site.whatsapp}` : 'Numéro à confirmer'}</dd></div>
        </dl>
        <div class="visit__actions">
          <WhatsAppButton label="Écrire sur WhatsApp" />
          <a class="link-underline" href={shopPaths.contact}>Nous trouver</a>
        </div>
      </div>
      <div class="visit__media">
        <div class="img-frame" style="aspect-ratio: 4 / 3;">
          <img src={visuals.atelier.src} alt={visuals.atelier.alt} width={visuals.atelier.width} height={visuals.atelier.height} loading="lazy" decoding="async" onerror={`this.onerror=null;this.src='${PLACEHOLDER}'`} />
        </div>
        <MapPlaceholder />
      </div>
    </div>
  </section>
</Base>

<style>
  .tiles { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--s-3); }
  .collections { display: grid; gap: var(--s-8); }

  .signature__head { display: grid; gap: var(--s-4); margin-bottom: var(--s-10); max-width: 48rem; }
  .signature__head > div { display: grid; gap: var(--s-4); justify-items: start; }
  .signature__eyebrow { color: var(--accent); }
  .signature__title { font-size: clamp(3rem, 2rem + 5vw, 6rem); line-height: 1; color: var(--paper); letter-spacing: 0; font-weight: 400; }
  .signature__text { font-size: var(--fs-md); opacity: 0.85; max-width: 52ch; }
  .signature__grid :global(.card__designer) { color: var(--paper); opacity: 0.6; }
  .signature__grid :global(.card__price) { color: var(--paper); opacity: 0.85; }
  .signature__grid :global(.card__new) { color: var(--accent); }
  .signature__grid :global(.card__old) { color: var(--paper); opacity: 0.5; }

  .visit { display: grid; gap: var(--s-10); }
  .visit__text { display: grid; gap: var(--s-4); align-content: start; }
  .visit__list { margin: var(--s-2) 0 0; display: grid; gap: var(--s-3); }
  .visit__list div { display: grid; gap: 2px; }
  .visit__list dd { margin: 0; }
  .visit__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-6); margin-top: var(--s-2); font-size: var(--fs-sm); }
  .visit__media { display: grid; gap: var(--s-3); }

  @media (min-width: 960px) {
    .tiles { grid-template-columns: repeat(4, 1fr); gap: var(--s-4); }
    .collections { grid-template-columns: repeat(3, 1fr); }
    .visit { grid-template-columns: 0.9fr 1.1fr; gap: var(--s-16); align-items: start; }
    .visit__media { grid-template-columns: 1.2fr 0.8fr; align-items: end; }
  }
</style>
