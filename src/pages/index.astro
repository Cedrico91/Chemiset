---
import { withBase, PLACEHOLDER } from '../lib/url';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CategoryTile from '../components/CategoryTile.astro';
import Services from '../components/Services.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProductGrid from '../components/ProductGrid.astro';
import MapPlaceholder from '../components/MapPlaceholder.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site } from '../config/site';
import { visuals } from '../data/catalogue';
import { orLabel } from '../lib/format';
import { getProduct, productsByDesigner, shopPaths } from '../lib/catalogue';

/**
 * Accueil volontairement court : hero, quatre rayons, les modèles de la boutique, les services, la boutique.
 * Nouveautés, collections, offres et créateurs ont leurs propres pages, accessibles depuis le menu.
 */
const houseModels = productsByDesigner('la-chemise-africaine').slice(0, 4);

/** Entrées par rayon. Les photos viennent du catalogue (à remplacer par les visuels de la boutique). */
const tileImage = (slug: string) => getProduct(slug)?.images[0] ?? visuals.duo;
const tiles = [
  { label: 'Chemises', note: 'La pièce signature', href: shopPaths.shirts, image: tileImage('chemise-col-mao-plastron-indigo') },
  { label: 'Femme', note: 'Robes, ensembles, tuniques', href: withBase('/catalogue/femme/'), image: tileImage('robe-ganvie') },
  { label: 'Homme', note: 'Chemises, tuniques, boubous', href: withBase('/catalogue/homme/'), image: tileImage('chemise-batik-ocre') },
  { label: 'Accessoires', note: 'Bijoux, foulards, sacs', href: withBase('/catalogue/accessoires/'), image: tileImage('collier-perles') },
];
---

<Base title={site.name} current="accueil">
  <Hero
    eyebrow={`${site.tagline} · ${site.city}`}
    title={site.positioning}
    text="Chemises, robes, ensembles et accessoires signés par des créateurs africains. Choisissez, ajoutez au panier, commandez sur WhatsApp."
    desktop={visuals.heroDesktop}
    mobile={visuals.heroMobile}
    primary={{ label: 'Voir les chemises', href: shopPaths.shirts }}
    secondary={{ label: 'Nouveautés', href: shopPaths.newArrivals }}
  />

  <section class="section section--tight">
    <div class="container">
      <div class="tiles">
        {tiles.map((t, i) => <CategoryTile {...t} eager={i < 2} />)}
      </div>
    </div>
  </section>

  {houseModels.length > 0 && (
    <section class="section signature">
      <div class="container">
        <SectionHeading eyebrow="Les modèles de la boutique" title="La chemise, signée par la maison" link={{ label: 'Toutes les chemises', href: shopPaths.shirts }} />
        <ProductGrid products={houseModels} eagerCount={4} />
      </div>
    </section>
  )}

  <section class="section section--tight section--paper-2">
    <div class="container">
      <Services />
    </div>
  </section>

  <section class="section" id="boutique">
    <div class="container visit">
      <div class="visit__text">
        <p class="eyebrow eyebrow--accent">La boutique</p>
        <h2 class="title-xl">Venez essayer, ou commandez depuis chez vous.</h2>
        <p class="lede">Nos pièces se découvrent en boutique à {site.city}, et sur WhatsApp pour tout le reste : conseil, commande, livraison.</p>
        <dl class="visit__list">
          <div><dt class="eyebrow">Adresse</dt><dd>{orLabel(site.address, 'À confirmer')}, {site.city}</dd></div>
          <div><dt class="eyebrow">Horaires</dt><dd>{orLabel(site.hours, 'À confirmer')}</dd></div>
          <div><dt class="eyebrow">WhatsApp</dt><dd>{site.whatsapp ? `+${site.whatsapp}` : 'Numéro à confirmer'}</dd></div>
        </dl>
        <div class="visit__actions">
          <WhatsAppButton label="Écrire sur WhatsApp" />
          <a class="link-underline" href={shopPaths.contact}>Nous trouver</a>
        </div>
      </div>
      <div class="visit__media">
        <div class="img-frame" style="aspect-ratio: 4 / 3;">
          <img src={visuals.atelier.src} alt={visuals.atelier.alt} width={visuals.atelier.width} height={visuals.atelier.height} loading="lazy" decoding="async" onerror={`this.onerror=null;this.src='${PLACEHOLDER}'`} />
        </div>
        <MapPlaceholder />
      </div>
    </div>
  </section>
</Base>

<style>
  .tiles { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--s-3); }
  .visit { display: grid; gap: var(--s-10); }
  .visit__text { display: grid; gap: var(--s-4); align-content: start; }
  .visit__list { margin: var(--s-2) 0 0; display: grid; gap: var(--s-3); }
  .visit__list div { display: grid; gap: 2px; }
  .visit__list dd { margin: 0; }
  .visit__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-6); margin-top: var(--s-2); font-size: var(--fs-sm); }
  .visit__media { display: grid; gap: var(--s-3); }
  @media (min-width: 960px) {
    .tiles { grid-template-columns: repeat(4, 1fr); gap: var(--s-4); }
    .visit { grid-template-columns: 0.9fr 1.1fr; gap: var(--s-16); align-items: start; }
    .visit__media { grid-template-columns: 1.2fr 0.8fr; align-items: end; }
  }
</style>
