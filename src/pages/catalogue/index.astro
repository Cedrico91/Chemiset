---
import Base from '../../layouts/Base.astro';
import CatalogueFilter from '../../components/CatalogueFilter.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { collections, products } from '../../lib/catalogue';
---

<Base title="Catalogue" description="Toutes les pièces de la boutique : femme, homme et accessoires, par nos créateurs." current="catalogue">
  <section class="section--tight section">
    <div class="container">
      <header class="head">
        <p class="eyebrow">Catalogue</p>
        <h1 class="title-xl">Toutes les pièces</h1>
        <p class="lede">Chemises, robes, ensembles et accessoires. Filtrez par catégorie ou par collection, puis commandez sur WhatsApp.</p>
      </header>
      <CatalogueFilter active="tous" collections={collections} />
      <ProductGrid products={products} eagerCount={4} />
    </div>
  </section>
</Base>

<style>
  .head { display: grid; gap: var(--s-3); margin-bottom: var(--s-8); }
</style>
