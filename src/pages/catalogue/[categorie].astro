---
import Base from '../../layouts/Base.astro';
import CatalogueFilter from '../../components/CatalogueFilter.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { categories, collections, productsByCategory } from '../../lib/catalogue';
import type { Category } from '../../data/types';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { categorie: c.id }, props: { category: c } }));
}
interface Props { category: Category; }
const { category } = Astro.props;
const items = productsByCategory(category.id);
const usedCollections = collections.filter((c) => items.some((p) => p.collectionSlug === c.slug));
---

<Base title={category.label} description={category.intro} current={category.id}>
  <section class="section--tight section">
    <div class="container">
      <header class="head">
        <p class="eyebrow">Catalogue</p>
        <h1 class="title-xl">{category.label}</h1>
        <p class="lede">{category.intro}</p>
      </header>
      <CatalogueFilter active={category.id} collections={usedCollections} />
      <ProductGrid products={items} eagerCount={4} />
    </div>
  </section>
</Base>

<style>
  .head { display: grid; gap: var(--s-3); margin-bottom: var(--s-8); }
</style>
