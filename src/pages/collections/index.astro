---
import Base from '../../layouts/Base.astro';
import CollectionCard from '../../components/CollectionCard.astro';
import { collections } from '../../lib/catalogue';
---

<Base title="Collections" description="Les collections de la boutique : La Chemise, Cérémonies, Lumière de Cotonou, Atelier & Tissus." current="collections">
  <section class="section--tight section">
    <div class="container">
      <header class="head">
        <p class="eyebrow">Collections</p>
        <h1 class="title-xl">Entrer par une histoire plutôt que par un rayon</h1>
        <p class="lede">Chaque collection rassemble des pièces de plusieurs créateurs autour d’un usage : la chemise de tous les jours, les grands jours, la saison, l’atelier.</p>
      </header>
      <div class="list">
        {collections.map((c) => <CollectionCard collection={c} size="lg" />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .head { display: grid; gap: var(--s-3); margin-bottom: var(--s-12); max-width: 50rem; }
  .list { display: grid; gap: var(--s-12) var(--s-8); }
  @media (min-width: 960px) { .list { grid-template-columns: 1fr 1fr; } }
</style>
