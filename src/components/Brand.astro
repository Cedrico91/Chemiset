---
/**
 * Logo de la boutique : emblème (t-shirt, carte d'Afrique, ciseaux) + lettrage script,
 * fidèle au logo transmis par le client (src/assets/brand/logo-original.jpeg).
 */
import { withBase } from '../lib/url';
import { site } from '../config/site';

interface Props {
  /** 'header' : compact ; 'footer' : grand, sur fond sombre ; 'hero' : lettrage seul, très grand. */
  variant?: 'header' | 'footer' | 'hero';
  href?: string;
}
const { variant = 'header', href = withBase('/') } = Astro.props;
const Tag = variant === 'hero' ? 'div' : 'a';
---

<Tag class:list={['brand', `brand--${variant}`]} href={Tag === 'a' ? href : undefined} aria-label={Tag === 'a' ? `${site.name} — accueil` : undefined}>
  {variant !== 'hero' && (
    <img class="brand__emblem" src={withBase('/brand/emblem-square.png')} alt="" width="512" height="512" loading="eager" decoding="async" />
  )}
  <span class="brand__text">
    <span class="brand__name">{site.name}</span>
    <span class="brand__tag">{site.tagline}</span>
  </span>
</Tag>

<style>
  .brand { display: inline-flex; align-items: center; gap: var(--s-2); flex: none; color: inherit; }
  .brand__emblem { width: 2.25rem; height: 2.25rem; flex: none; border-radius: 2px; background: #000; object-fit: cover; }
  .brand__text { display: flex; flex-direction: column; line-height: 1; }
  .brand__name {
    /* Jamais tronqué : la taille s'adapte à la largeur de l'écran. */
    font-family: var(--font-script); font-size: clamp(1.1rem, 4.4vw, 1.6rem); white-space: nowrap;
    letter-spacing: 0.005em; padding-right: 0.15em; /* la queue des lettres script dépasse à droite */
  }
  .brand__tag { font-size: 0.6rem; font-weight: 600; letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--accent); margin-top: 0.35em; }

  .brand--footer .brand__emblem { width: 3.5rem; height: 3.5rem; }
  .brand--footer .brand__name { font-size: 2rem; }
  .brand--footer .brand__tag { font-size: 0.7rem; }

  .brand--hero { display: block; }
  .brand--hero .brand__name { font-size: clamp(2.5rem, 2rem + 4vw, 5rem); white-space: normal; line-height: 1.05; }
  .brand--hero .brand__tag { font-size: var(--fs-sm); margin-top: var(--s-3); }

  @media (min-width: 640px) { .brand { gap: var(--s-3); } .brand__emblem { width: 2.5rem; height: 2.5rem; } }
</style>
