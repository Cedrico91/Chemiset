---
import { PLACEHOLDER } from '../lib/url';
import type { ImageRef } from '../data/types';
import Button from './Button.astro';

interface Props {
  eyebrow: string;
  title: string;
  text?: string;
  desktop: ImageRef;
  mobile: ImageRef;
  primary: { label: string; href: string };
  secondary?: { label: string; href: string };
}
const { eyebrow, title, text, desktop, mobile, primary, secondary } = Astro.props;
---

<section class="hero">
  <picture class="hero__media">
    <source media="(max-width: 767px)" srcset={mobile.src} width={mobile.width} height={mobile.height} />
    <img
      src={desktop.src}
      alt={desktop.alt}
      width={desktop.width}
      height={desktop.height}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      onerror={`this.onerror=null;this.src='${PLACEHOLDER}'`}
    />
  </picture>
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="container hero__content">
    <p class="eyebrow hero__eyebrow">{eyebrow}</p>
    <h1 class="hero__title display">{title}</h1>
    {text && <p class="hero__text">{text}</p>}
    <div class="hero__actions">
      <Button href={primary.href} variant="accent" size="lg">{primary.label}</Button>
      {secondary && <Button href={secondary.href} variant="light" size="lg">{secondary.label}</Button>}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative; isolation: isolate;
    min-height: min(calc(100svh - var(--header-h)), 54rem);
    display: flex; align-items: flex-end;
    color: var(--paper); background: var(--ink);
  }
  .hero__media { position: absolute; inset: 0; z-index: -2; overflow: hidden; }
  .hero__media img { width: 100%; height: 100%; object-fit: cover; object-position: center 20%; animation: hero-in 1.6s var(--ease) both; }
  .hero__shade {
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(to top, rgb(0 0 0 / 0.78) 0%, rgb(0 0 0 / 0.3) 45%, rgb(0 0 0 / 0.08) 100%);
  }
  .hero__content { padding-block: var(--s-16) var(--s-12); display: grid; gap: var(--s-5); }
  .hero__eyebrow { color: var(--accent); animation: fade-up 0.8s var(--ease) 0.2s both; }
  .hero__title { max-width: 14ch; font-weight: 600; letter-spacing: -0.025em; animation: fade-up 0.9s var(--ease) 0.35s both; }
  .hero__text { font-size: var(--fs-md); max-width: 46ch; opacity: 0.9; animation: fade-up 0.9s var(--ease) 0.5s both; }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3); margin-top: var(--s-2); animation: fade-up 0.9s var(--ease) 0.65s both; }
  @keyframes hero-in { from { transform: scale(1.06); } to { transform: scale(1); } }
  @keyframes fade-up { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @media (min-width: 960px) { .hero__content { padding-bottom: var(--s-20); } }
</style>
